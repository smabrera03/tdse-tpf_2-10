/********************** macros and definitions *******************************/
#define G_TASK_BTN_CNT_INIT			0ul
#define G_TASK_BTN_TICK_CNT_INI		0ul

#define DEL_BTN_XX_MIN				0ul
#define DEL_BTN_XX_MED				25ul
#define DEL_BTN_XX_MAX				50ul

/********************** internal data declaration ****************************/
const task_boton_cfg_t task_boton_cfg_list[] = {
	{ID_BTN_Q,  BTN_Q_GPIO_Port,  BTN_Q_Pin,  GPIO_PIN_RESET, DEL_BTN_XX_MAX,
	 EV_SYS_IDLE,  EV_SYS_LOOP_DET}
};

#define BOTON_CFG_QTY	(sizeof(task_boton_cfg_list)/sizeof(task_boton_cfg_t))

task_boton_dta_t task_boton_dta_list[] = {
	{DEL_BTN_XX_MIN, ST_BTN_XX_UP, EV_BTN_XX_UP}
};

#define BOTON_DTA_QTY	(sizeof(task_boton_dta_list)/sizeof(task_boton_dta_t))

/********************** internal functions declaration ***********************/
void task_boton_statechart(void);

/********************** internal data definition *****************************/
const char *p_task_boton 		= "Task Sensor (Sensor Statechart)";
const char *p_task_boton_ 		= "Non-Blocking & Update By Time Code";

/********************** external data declaration ****************************/
uint32_t g_task_boton_cnt;
volatile uint32_t g_task_boton_tick_cnt;

/********************** external functions definition ************************/
void task_boton_init(void *parameters)
{
	uint32_t index;
	task_boton_dta_t *p_task_boton_dta;
	task_boton_st_t state;
	task_boton_ev_t event;

	/* Print out: Task Initialized */
	LOGGER_INFO(" ");
	LOGGER_INFO("  %s is running - %s", GET_NAME(task_boton_init), p_task_boton);
	LOGGER_INFO("  %s is a %s", GET_NAME(task_boton), p_task_boton_);

	/* Init & Print out: Task execution counter */
	g_task_boton_cnt = G_TASK_BTN_CNT_INIT;
	LOGGER_INFO("   %s = %lu", GET_NAME(g_task_boton_cnt), g_task_boton_cnt);

	for (index = 0; BOTON_DTA_QTY > index; index++)
	{
		/* Update Task Boton Data Pointer */
		p_task_boton_dta = &task_boton_dta_list[index];

		/* Init & Print out: Index & Task execution FSM */
		state = ST_BTN_XX_UP;
		p_task_boton_dta->state = state;

		event = EV_BTN_XX_UP;
		p_task_boton_dta->event = event;

		LOGGER_INFO(" ");
		LOGGER_INFO("   %s = %lu   %s = %lu   %s = %lu",
				    GET_NAME(index), index,
					GET_NAME(state), (uint32_t)state,
					GET_NAME(event), (uint32_t)event);
	}
}

void task_boton_update(void *parameters)
{
	bool b_time_update_required = false;

	/* Protect shared resource */
	__asm("CPSID i");	/* disable interrupts */
    if (G_TASK_BTN_TICK_CNT_INI < g_task_boton_tick_cnt)
    {
		/* Update Tick Counter */
    	g_task_boton_tick_cnt--;
    	b_time_update_required = true;
    }
    __asm("CPSIE i");	/* enable interrupts */

    while (b_time_update_required)
    {
		/* Update Task Counter */
		g_task_boton_cnt++;

		/* Run Task Statechart */
    	task_boton_statechart();

    	/* Protect shared resource */
		__asm("CPSID i");	/* disable interrupts */
		if (G_TASK_BTN_TICK_CNT_INI < g_task_boton_tick_cnt)
		{
			/* Update Tick Counter */
			g_task_boton_tick_cnt--;
			b_time_update_required = true;
		}
		else
		{
			b_time_update_required = false;
		}
		__asm("CPSIE i");	/* enable interrupts */
    }
}

void task_boton_statechart(void)
{
	uint32_t index;
	const task_boton_cfg_t *p_task_boton_cfg;
	task_boton_dta_t *p_task_boton_dta;

	for (index = 0; BOTON_DTA_QTY > index; index++)
	{
		/* Update Task Boton Configuration & Data Pointer */
		p_task_boton_cfg = &task_boton_cfg_list[index];
		p_task_boton_dta = &task_boton_dta_list[index];

		if (p_task_boton_cfg->pressed == HAL_GPIO_ReadPin(p_task_boton_cfg->gpio_port, p_task_boton_cfg->pin))
		{
			p_task_boton_dta->event =	EV_BTN_XX_DOWN;
		}
		else
		{
			p_task_boton_dta->event =	EV_BTN_XX_UP;
		}

		switch (p_task_boton_dta->state)
		{
			case ST_BTN_XX_UP:

				if (EV_BTN_XX_DOWN == p_task_boton_dta->event)
				{
					p_task_boton_dta->state = ST_BTN_XX_FALLING;
					p_task_boton_dta->tick = DEL_BTN_XX_MAX;
				}

				break;

			case ST_BTN_XX_FALLING:
				if(p_task_boton_dta->tick == DEL_BTN_XX_MIN){
					if(p_task_boton_dta->event == EV_BTN_XX_UP){
						p_task_boton_dta->state = ST_BTN_XX_UP;
					}else{
						p_task_boton_dta->state = ST_BTN_XX_DOWN;
						put_event_task_system(p_task_boton_cfg->signal_down);
					}
				}
				break;

			case ST_BTN_XX_DOWN:

				if (EV_BTN_XX_UP == p_task_boton_dta->event)
				{
					put_event_task_system(p_task_boton_cfg->signal_up);
					p_task_boton_dta->state = ST_BTN_XX_UP;
				}

				break;

			case ST_BTN_XX_RISING:

				break;

			default:

				p_task_boton_dta->tick  = DEL_BTN_XX_MIN;
				p_task_boton_dta->state = ST_BTN_XX_UP;
				p_task_boton_dta->event = EV_BTN_XX_UP;

				break;
		}
	}
}

