/********************** macros and definitions *******************************/
#define G_TASK_LED_CNT_INIT			0ul
#define G_TASK_LED_TICK_CNT_INI		0ul

#define DEL_LED_XX_PUL				500ul
#define DEL_LED_XX_BLI				500ul
#define DEL_LED_XX_MIN				0ul

/********************** internal data declaration ****************************/
const task_led_cfg_t task_led_cfg_list[] = {
	{ID_LED_ROJA,  LED_ROJA_GPIO_Port,  LED_ROJA_Pin, GPIO_PIN_SET,  GPIO_PIN_RESET,
	 DEL_LED_XX_BLI, DEL_LED_XX_PUL},
	 {ID_LED_AMARILLA, LED_AMARILLA_GPIO_Port, LED_AMARILLA_Pin, GPIO_PIN_SET, GPIO_PIN_RESET,
	 DEL_LED_XX_BLI, DEL_LED_XX_PUL},
	 {ID_LED_VERDE, LED_VERDE_GPIO_Port, LED_VERDE_Pin, GPIO_PIN_SET, GPIO_PIN_RESET,
	 DEL_LED_XX_BLI, DEL_LED_XX_PUL}
};

#define LED_CFG_QTY	(sizeof(task_led_cfg_list)/sizeof(task_led_cfg_t))

task_led_dta_t task_led_dta_list[] = {
	{DEL_LED_XX_MIN, ST_LED_OFF, EV_LED_NOT_BLINK, false}
};

#define LED_DTA_QTY	(sizeof(task_led_dta_list)/sizeof(task_led_dta_t))

/********************** internal functions declaration ***********************/
void task_led_statechart(void);

/********************** internal data definition *****************************/
const char *p_task_led 		= "Task Actuator (Actuator Statechart)";
const char *p_task_led_ 		= "Non-Blocking & Update By Time Code";

/********************** external data declaration ****************************/
uint32_t g_task_led_cnt;
volatile uint32_t g_task_led_tick_cnt;

/********************** external functions definition ************************/
void task_led_init(void *parameters)
{
	uint32_t index;
	const task_led_cfg_t *p_task_led_cfg;
	task_led_dta_t *p_task_led_dta;
	task_led_st_t state;
	task_led_ev_t event;
	bool b_event;

	/* Print out: Task Initialized */
	LOGGER_INFO(" ");
	LOGGER_INFO("  %s is running - %s", GET_NAME(task_led_init), p_task_led);
	LOGGER_INFO("  %s is a %s", GET_NAME(task_led), p_task_led_);

	/* Init & Print out: Task execution counter */
	g_task_led_cnt = G_TASK_LED_CNT_INIT;
	LOGGER_INFO("   %s = %lu", GET_NAME(g_task_led_cnt), g_task_led_cnt);

	for (index = 0; LED_DTA_QTY > index; index++)
	{
		/* Update Task Actuator Configuration & Data Pointer */
		p_task_led_cfg = &task_led_cfg_list[index];
		p_task_led_dta = &task_led_dta_list[index];

		/* Init & Print out: Index & Task execution FSM */
		state = ST_LED_OFF;
		p_task_led_dta->state = state;

		event = EV_LED_OFF;
		p_task_led_dta->event = event;

		b_event = false;
		p_task_led_dta->flag = b_event;

		LOGGER_INFO(" ");
		LOGGER_INFO("   %s = %lu   %s = %lu   %s = %lu   %s = %s",
					 GET_NAME(index), index,
					 GET_NAME(state), (uint32_t)state,
					 GET_NAME(event), (uint32_t)event,
					 GET_NAME(b_event), (b_event ? "true" : "false"));

		HAL_GPIO_WritePin(p_task_led_cfg->gpio_port, p_task_led_cfg->pin, p_task_led_cfg->led_off);
	}
}

void task_led_update(void *parameters)
{
	bool b_time_update_required = false;

	/* Protect shared resource */
	__asm("CPSID i");	/* disable interrupts*/
    if (G_TASK_LED_TICK_CNT_INI < g_task_led_tick_cnt)
    {
		/* Update Tick Counter */
    	g_task_led_tick_cnt--;
    	b_time_update_required = true;
    }
    __asm("CPSIE i");	/* enable interrupts */

    while (b_time_update_required)
    {
		/* Update Task Counter */
		g_task_led_cnt++;

		/* Run Task Statechart */
    	task_led_statechart();

    	/* Protect shared resource */
		__asm("CPSID i");	/* disable interrupts */
		if (G_TASK_LED_TICK_CNT_INI < g_task_led_tick_cnt)
		{
			/* Update Tick Counter */
			g_task_led_tick_cnt--;
			b_time_update_required = true;
		}
		else
		{
			b_time_update_required = false;
		}
		__asm("CPSIE i");	/* enable interrupts */
    }
}

void task_led_statechart(void)
{
	uint32_t index;
	const task_led_cfg_t *p_task_led_cfg;
	task_led_dta_t *p_task_led_dta;

	for (index = 0; LED_DTA_QTY > index; index++)
	{
		/* Update Task Actuator Configuration & Data Pointer */
		p_task_led_cfg = &task_led_cfg_list[index];
		p_task_led_dta = &task_led_dta_list[index];

		task_led_ev_t evento = p_task_led_dta->event;
		bool flag = p_task_led_dta->flag;
		switch (p_task_led_dta->state)
		{
			case ST_LED_OFF:

				if ((true == flag) && (EV_LED_ON == evento))
				{
					p_task_led_dta->flag = false;
					HAL_GPIO_WritePin(p_task_led_cfg->gpio_port, p_task_led_cfg->pin, p_task_led_cfg->led_on);
					p_task_led_dta->state = ST_LED_ON;
				}

				if((flag == true) && (evento == EV_LED_BLINK)){
					p_task_led_dta->flag = false;
					p_task_led_dta->tick = p_task_led_cfg->tick_blink;
					p_task_led_dta->state = ST_LED_BLINK_ON;
					HAL_GPIO_WritePin(p_task_led_cfg->gpio_port, p_task_led_cfg->pin, p_task_led_cfg->led_on);
				}

				if((flag == true) && (evento == EV_LED_PULSE)){
					p_task_led_dta->flag = false;
					p_task_led_dta->tick = p_task_led_cfg->tick_pulse;
					p_task_led_dta->state = ST_LED_PULSE;
					HAL_GPIO_WritePin(p_task_led_cfg->gpio_port, p_task_led_cfg->pin, p_task_led_cfg->led_on);
				}

				break;

			case ST_LED_ON:

				if ((true == flag) && (EV_LED_OFF == evento))
				{
					p_task_led_dta->flag = false;
					HAL_GPIO_WritePin(p_task_led_cfg->gpio_port, p_task_led_cfg->pin, p_task_led_cfg->led_off);
					p_task_led_dta->state = ST_LED_OFF;
				}

				if((flag == true) && (EV_LED_BLINK)){
					p_task_led_dta->flag = false;
					p_task_led_dta->tick = p_task_led_cfg->tick_blink;
					p_task_led_dta->state = ST_LED_BLINK_ON;
					HAL_GPIO_WritePin(p_task_led_cfg->gpio_port, p_task_led_cfg->pin, p_task_led_cfg->led_on);
				}
				break;

			case ST_LED_BLINK_ON:
				if((flag == true) && (evento == EV_LED_OFF)){
					p_task_led_dta->flag = false;
					p_task_led_dta->state = ST_LED_OFF;
					HAL_GPIO_WritePin(p_task_led_cfg->gpio_port, p_task_led_cfg->pin, p_task_led_cfg->led_off);
				}

				if((flag == true) && (evento == EV_LED_ON)){
					p_task_led_dta->flag = false;
					p_task_led_dta->state = ST_LED_ON;
				}

				if(p_task_led_dta->tick == 0){
					p_task_led_dta->tick = p_task_led_cfg->tick_blink;
					p_task_led_dta->state = ST_LED_BLINK_OFF;
				}else{
					p_task_led_dta->tick--;
				}

				break;

			case ST_LED_BLINK_OFF:
				if((flag == true) && (evento == EV_LED_OFF)){
					p_task_led_dta->flag = false;
					p_task_led_dta->state = ST_LED_OFF;
				}

				if((flag == true) && (evento == EV_LED_ON)){
					p_task_led_dta->flag = false;
					p_task_led_dta->state = ST_LED_ON;
				}

				if(p_task_led_dta->tick == 0){
					p_task_led_dta->tick = p_task_led_cfg->tick_blink;
					p_task_led_dta->state = ST_LED_BLINK_ON;
				}else{
					p_task_led_dta->tick--;
				}
				break;

			case ST_LED_PULSE:

				break;

			default:

				p_task_led_dta->tick  = DEL_LED_XX_MIN;
				p_task_led_dta->state = ST_LED_OFF;
				p_task_led_dta->event = EV_LED_OFF;
				p_task_led_dta->flag = false;

				break;
		}
	}
}

