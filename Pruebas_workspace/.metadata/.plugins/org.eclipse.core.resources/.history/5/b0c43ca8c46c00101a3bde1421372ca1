void cambiar_puntos(int puntos) {
	int cant_de_cincos = puntos / 5;
	int resto = puntos % 5;
	int i;
	for (i = 0; i<cant_de_cincos; i++) {
		I2C_LCD_SetCursor(MyI2C_LCD, i, 0);
		I2C_LCD_PrintCustomChar(MyI2C_LCD, 5);
	}
	I2C_LCD_SetCursor(MyI2C_LCD, i, 0);
	I2C_LCD_PrintCustomChar(MyI2C_LCD, resto);
}
