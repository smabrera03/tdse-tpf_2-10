/* Events to excite Task System */
//typedef enum task_system_ev {EV_SYS_XX_IDLE, EV_SYS_XX_ACTIVE} task_system_ev_t;
typedef enum task_system_ev {EV_SYS_CARTA_NUEVA,
	EV_SYS_CARTA_ERR,
	EV_SYS_BTN_TRU,
	EV_SYS_BTN_ENV,
	EV_SYS_BTN_Q, //botón quiero
	EV_SYS_BTN_NQ //botón no quiero
} task_system_ev_t;



/* State of Task System */
typedef enum task_system_st {ST_SYS_RONDA,
	//dentro de ronda existen los siguientes subestados:
	ST_SYS_M1,
	ST_SYS_M2,
	ST_SYS_M3, //manos
	ST_SYS_TJ1,
	ST_SYS_TJ2, //turnos

	ST_SYS_TRUCO_PENDIENTE,
	//dentro de truco_pendiente existen los siguientes subestados:
	ST_SYS_J1_RESPONDE,
	ST_SYS_J2_RESPONDE,

	ST_SYS_SELECCIONAR_ENVIDO,
	//dentro de SELECCIONAR_ENVIDO existen los siguientes subestados:
	ST_SYS_E,//envido
	ST_SYS_RE,//real envido
	ST_SYS_FE,//falta envido

	ST_SYS_ENVIDO_PENDIENTE,
	//dentro de ENVIDO_PENDIENTE existen los siguientes subestados:
	ST_SYS_RTA_PENDIENTE,
	ST_SYS_DEFINIR_GANADOR
} task_system_st_t;

typedef enum jugador_enum {NINGUNO, J1, J2} jugador_enum_t; //enum que identifica a los jugadores
//así si quiero alternar entre jugadores puedo hacer jugador = (jugador)%2 + 1;

