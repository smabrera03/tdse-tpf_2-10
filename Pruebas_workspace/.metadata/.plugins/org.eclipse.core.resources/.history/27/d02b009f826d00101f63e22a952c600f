volatile uint32_t g_task_keypad_tick_cnt;

/********************** external functions definition ************************/
void task_keypad_init(void *parameters)
{
	uint32_t index;
	task_keypad_dta_t *p_task_keypad_dta;
	const task_keypad_cfg_t *p_task_keypad_cfg;
	task_keypad_st_t state;
	task_keypad_ev_t event;

	/* Print out: Task Initialized */
	LOGGER_LOG("  %s is running - %s\r\n", GET_NAME(task_keypad_init), p_task_keypad);
	LOGGER_LOG("  %s is a %s\r\n", GET_NAME(task_keypad), p_task_keypad_);

	g_task_keypad_cnt = G_TASK_KEY_CNT_INIT;

	/* Print out: Task execution counter */
	LOGGER_LOG("   %s = %lu\r\n", GET_NAME(g_task_keypad_cnt), g_task_keypad_cnt);

	for (index = 0; KEYPAD_DTA_QTY > index; index++)
	{
		/* Update Task Keypad Data Pointer */
		p_task_keypad_dta = &task_keypad_dta_list[index];
		p_task_keypad_cfg = &task_keypad_cfg_list[index];

		/* Print out: Index & Task execution FSM */
		LOGGER_LOG("   %s = %lu", GET_NAME(index), index);

		state = p_task_keypad_dta->state;
		LOGGER_LOG("   %s = %lu", GET_NAME(state), (uint32_t)state);

		event = p_task_keypad_dta->event;
		LOGGER_LOG("   %s = %lu\r\n", GET_NAME(event), (uint32_t)event);

		KEYPAD_Init(0, p_task_keypad_cfg->KeyStatesList);
	}
	g_task_keypad_tick_cnt = G_TASK_KEY_TICK_CNT_INI;
}

void task_keypad_update(void *parameters)
{
	uint32_t index;
	const task_keypad_cfg_t *p_task_keypad_cfg;
	task_keypad_dta_t *p_task_keypad_dta;
	bool b_time_update_required = false;

	/* Update Task Sensor Counter */
	g_task_keypad_cnt++;

	/* Protect shared resource (g_task_keypad_tick_cnt) */
	__asm("CPSID i");	/* disable interrupts*/
    if (G_TASK_KEY_TICK_CNT_INI < g_task_keypad_tick_cnt)
    {
    	g_task_keypad_tick_cnt--;
    	b_time_update_required = true;
    }
    __asm("CPSIE i");	/* enable interrupts*/

    while (b_time_update_required)
    {
		/* Protect shared resource (g_task_keypad_tick_cnt) */
		__asm("CPSID i");	/* disable interrupts*/
		if (G_TASK_KEY_TICK_CNT_INI < g_task_keypad_tick_cnt)
		{
			g_task_keypad_tick_cnt--;
			b_time_update_required = true;
		}
		else
		{
			b_time_update_required = false;
		}
		__asm("CPSIE i");	/* enable interrupts*/

		/*
		 * Acá, cada vez que pase por acá leer los inputs
		 * si alguno es 1 -> tick--
		 * si tick == 0, flag = true
		 */
    	for (index = 0; KEYPAD_DTA_QTY > index; index++)
		{
    		/* Update Task Sensor Configuration & Data Pointer */
			p_task_keypad_cfg = &task_keypad_cfg_list[index];
			p_task_keypad_dta = &task_keypad_dta_list[index];


			row_statechart();

			switch(p_task_keypad_dta->state)
			{

				case ST_KEY_ESCRIBIR_VALOR:
					if((p_task_keypad_dta->flag_evento_nuevo == true) && (p_task_keypad_dta->event == EV_KEY_LECTURA)){
						//siendo que no hay otros eventos este if podría evitarse, pero lo dejo xq conceptualmente me parece importante y tal vez las haya dsp.
						KEYPAD_GetChar(ID_KEYPAD, &p_task_keypad_dta->lectura);
						uint8_t valor = Carta_Valor(p_task_keypad_dta->lectura);
						if(valor == 0){
							//error
							put_event_task_system(p_task_keypad_cfg->signal_ERR);//signal_ERR es EV_SYS_CARTA_ERR
							DB_signal = p_task_keypad_cfg->signal_ERR;
							return;
						}
					//si llego acá el valor es correcto
					p_task_keypad_dta->valorCarta = valor;
					p_task_keypad_dta->state = ST_KEY_ESCRIBIR_PALO;
					}
					break;
				case ST_KEY_ESCRIBIR_PALO:
					if((p_task_keypad_dta->flag_evento_nuevo == true) && (p_task_keypad_dta->event == EV_KEY_LECTURA)){
						KEYPAD_GetChar(&p_task_keypad_dta->lectura);
						palo_t palo = Carta_Palo(p_task_keypad_dta->lectura);
						if(palo == PALO_ERR){
							//error
							put_event_task_system(p_task_keypad_cfg->signal_ERR);
							p_task_keypad_dta->state = ST_KEY_ESCRIBIR_VALOR;
							DB_signal = p_task_keypad_cfg->signal_ERR;
							return;
						}
						//si llego acá es porque el plao es correcto
						p_task_keypad_dta->paloCarta = palo;
						p_task_keypad_dta->state = ST_KEY_CONFIRMAR;
					}
					break;
				case ST_KEY_CONFIRMAR:
					if((p_task_keypad_dta->flag_evento_nuevo == true) && (p_task_keypad_dta->event == EV_KEY_LECTURA)){
						KEYPAD_GetChar(&p_task_keypad_dta->lectura);
						if(lectura == '#'){
							//carta confirmada
							put_event_task_system(p_task_keypad_cfg->signal_OK); //en este caso, EV_CARTA_NUEVA
							put_Carta(p_task_keypad_dta->paloCarta, p_task_keypad_dta->valorCarta);
							DB_signal = p_task_keypad_cfg->signal_OK;
							p_task_keypad_dta->state = ST_KEY_ESCRIBIR_VALOR;
						}else{
							//borrar carta
							put_event_task_system(p_task_keypad_cfg->signal_ERR);
							DB_signal = p_task_keypad_cfg->signal_ERR;
							p_task_keypad_dta->state = ST_KEY_ESCRIBIR_VALOR;
						}
					}
					break;
				default:
					break;
			}
		}
    }
}


//esta función en básicamente una copia de la que hay en boton.c, pero en donde el "boton" es la combinación de las filas
static void row_statechart(void){
	const task_keypad_cfg_t *p_task_keypad_cfg = &task_keypad_cfg_list[0];
	task_keypad_dta_t *p_task_keypad_dta = &task_keypad_dta_list[0];

	GPIO_PinState C0 = HAL_GPIO_ReadPin(p_task_keypad_cfg->COL_gpio_ports[0], p_task_keypad_cfg->COL_Pins[0]);
	GPIO_PinState C1 = HAL_GPIO_ReadPin(p_task_keypad_cfg->COL_gpio_ports[1], p_task_keypad_cfg->COL_Pins[1]);
	GPIO_PinState C2 = HAL_GPIO_ReadPin(p_task_keypad_cfg->COL_gpio_ports[2], p_task_keypad_cfg->COL_Pins[2]);
	GPIO_PinState C3 = HAL_GPIO_ReadPin(p_task_keypad_cfg->COL_gpio_ports[3], p_task_keypad_cfg->COL_Pins[3]);

	if(C0 == GPIO_PIN_SET || C1 == GPIO_PIN_SET || C2 == GPIO_PIN_SET || C3 == GPIO_PIN_SET){
		p_task_keypad_dta->row_event = EV_ROW_DOWN;
	}else{
		p_task_keypad_dta->row_event = EV_ROW_UP;
	}

	switch(p_task_keypad_dta->row_state){

		case ST_ROW_DOWN:
			if (EV_ROW_UP == p_task_keypad_dta->row_event)
				{
					p_task_keypad_dta->row_state = ST_ROW_RISING;
					p_task_keypad_dta->tick = DEL_BTN_XX_MAX;
				}

			break;

		case ST_ROW_FALLING:
			if((p_task_keypad_dta->tick == DEL_BTN_XX_MIN) && (p_task_keypad_dta->row_event == EV_ROW_UP)){
					p_task_keypad_dta->row_state = ST_ROW_UP;
				}else if((p_task_keypad_dta->tick == DEL_BTN_XX_MIN) && (p_task_keypad_dta->row_event == EV_ROW_DOWN)){
					p_task_keypad_dta->row_state = ST_ROW_DOWN;
					//put_event_task_system(p_task_keypad_cfg->signal_down);
					p_task_keypad_dta->flag_evento_nuevo = true;
				}else{
					p_task_keypad_dta->tick--;
				}
			break;

		case ST_ROW_UP:
			if (EV_ROW_DOWN == p_task_keypad_dta->row_event)
				{
					p_task_keypad_dta->row_state = ST_ROW_FALLING;
					p_task_keypad_dta->tick = DEL_BTN_XX_MAX;
				}
			break;

		case ST_ROW_RISING:
			if((p_task_keypad_dta->tick == DEL_BTN_XX_MIN) && (p_task_keypad_dta->row_event == EV_ROW_UP)){
				p_task_keypad_dta->row_state = ST_ROW_UP;
			}else if((p_task_keypad_dta->tick == DEL_BTN_XX_MIN) && (p_task_keypad_dta->row_event == EV_ROW_DOWN)){
				p_task_keypad_dta->row_state = ST_ROW_DOWN;
			}else{
				p_task_keypad_dta->tick--;
			}
			break;

		default:
			break;

	}

}

void task_sensor_it_handler(uint16_t GPIO_Pin){
	if(GPIO_Pin == R0_Pin || GPIO_Pin == R1_Pin || GPIO_Pin == R2_Pin || GPIO_Pin == R3_Pin){ //este bloque if aparece 2 veces ¿Está mal?
		//ISR del KEYPAD
		task_sensor_dta_list[ID_KEYPAD].flag_evento_nuevo = true; //levanto el flag
		task_sensor_dta_list[ID_KEYPAD].event = EV_KEY_LECTURA;
		//--------Una vez registrada la interrupción, deshabilito las interrupciones para que el teclado funcione normalmente
		HAL_NVIC_DisableIRQ(EXTI4_IRQn);
		HAL_NVIC_DisableIRQ(EXTI9_5_IRQn);
		HAL_NVIC_DisableIRQ(EXTI15_10_IRQn);
		//--------------------------------------

		char *charaddrs = &task_sensor_dta_list[ID_KEYPAD].lectura;
		KEYPAD_GetChar(0, charaddrs);
		//Vuelvo a activar las interrupciones

		HAL_NVIC_EnableIRQ(EXTI4_IRQn);
		HAL_NVIC_EnableIRQ(EXTI9_5_IRQn);
		HAL_NVIC_EnableIRQ(EXTI15_10_IRQn);
		HAL_NVIC_ClearPendingIRQ(EXTI4_IRQn);
		HAL_NVIC_ClearPendingIRQ(EXTI9_5_IRQn);
		HAL_NVIC_ClearPendingIRQ(EXTI15_10_IRQn);

		return;
	}

	switch(GPIO_Pin){
	//ISR´s de los botones
		case Q_Pin:
			task_sensor_dta_list[ID_BTN_Q].flag_evento_nuevo = true;
			break;
		case NQ_Pin:
			task_sensor_dta_list[ID_BTN_NQ].flag_evento_nuevo = true;
			break;
		case TRU_Pin:
			task_sensor_dta_list[ID_BTN_TRU].flag_evento_nuevo = true;
			break;
		case ENV_Pin:
			task_sensor_dta_list[ID_BTN_ENV].flag_evento_nuevo = true;
			break;
		default:
			break;

	}
}

//Esta función asigna el valor numérico de la carta en base al char leído
//Si el char no es algún valor correcto devuelve 0 a modo de error, lo que se verifica en el bloque switch de
//sensor_update
static uint8_t Carta_Valor(char lectura){
	switch(lectura){
		case '1':return 1;
		case '2':return 2;
		case '3':return 3;
		case '4':return 4;
		case '5':return 5;
		case '6':return 6;
		case '7':return 7;
		case 'S':return 10;
		case 'Q':return 11;
		case 'R':return 12;
		default: return 0;
	}
}

//acá no puedo devolver 0 como error xq ESPADA es 0. Quedó distinto de Carta_Valor. ¿Corregir?
static palo_t Carta_Palo(char lectura){
	switch(lectura){
		case 'E': return ESPADA;
		case 'B': return BASTO;
		case 'C': return COPA;
		case 'O': return ORO;
		default: return PALO_ERR;
	}
}
