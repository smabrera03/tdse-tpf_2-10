void task_sensor_it_handler(uint16_t GPIO_Pin){
	if(GPIO_Pin == R0_Pin || GPIO_Pin == R1_Pin || GPIO_Pin == R2_Pin || GPIO_Pin == R3_Pin){ //este bloque if aparece 2 veces ¿Está mal?
		//ISR del KEYPAD
		task_sensor_dta_list[ID_KEYPAD].flag_evento_nuevo = true; //levanto el flag
		task_sensor_dta_list[ID_KEYPAD].event = EV_KEY_LECTURA;
		//--------Una vez registrada la interrupción, deshabilito las interrupciones para que el teclado funcione normalmente
		HAL_NVIC_DisableIRQ(EXTI4_IRQn);
		HAL_NVIC_DisableIRQ(EXTI9_5_IRQn);
		HAL_NVIC_DisableIRQ(EXTI15_10_IRQn);
		//--------------------------------------

		char *charaddrs = &task_sensor_dta_list[ID_KEYPAD].lectura;
		KEYPAD_GetChar(0, charaddrs);
		//Vuelvo a activar las interrupciones

		HAL_NVIC_EnableIRQ(EXTI4_IRQn);
		HAL_NVIC_EnableIRQ(EXTI9_5_IRQn);
		HAL_NVIC_EnableIRQ(EXTI15_10_IRQn);
		HAL_NVIC_ClearPendingIRQ(EXTI4_IRQn);
		HAL_NVIC_ClearPendingIRQ(EXTI9_5_IRQn);
		HAL_NVIC_ClearPendingIRQ(EXTI15_10_IRQn);

		return;
	}

	switch(GPIO_Pin){
	//ISR´s de los botones
		default:
			break;

	}
}

//Esta función asigna el valor numérico de la carta en base al char leído
//Si el char no es algún valor correcto devuelve 0 a modo de error, lo que se verifica en el bloque switch de
//sensor_update
static uint8_t Carta_Valor(char lectura){
	switch(lectura){
		case '1':return 1;
		case '2':return 2;
		case '3':return 3;
		case '4':return 4;
		case '5':return 5;
		case '6':return 6;
		case '7':return 7;
		case 'S':return 10;
		case 'Q':return 11;
		case 'R':return 12;
		default: return 0;
	}
}

//acá no puedo devolver 0 como error xq ESPADA es 0. Quedó distinto de Carta_Valor. ¿Corregir?
static palo_t Carta_Palo(char lectura){
	switch(lectura){
		case 'E': return ESPADA;
		case 'B': return BASTO;
		case 'C': return COPA;
		case 'O': return ORO;
		default: return -1;
	}
}
